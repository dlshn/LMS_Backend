generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

model TuitionClass {
  id         String   @id @default(uuid())
  name       String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  admins      Admin[]
  students    Student[]
  attendances Attendance[]
  exams       Exam[]
}

model Admin {
  id             String        @id @default(uuid())
  tuitionClassId String?
  tuitionClass   TuitionClass? @relation(fields: [tuitionClassId], references: [id])
  name           String
  email          String        @unique
  passwordHash   String
  role           AdminRole     @default(ADMIN)
  createdAt      DateTime      @default(now())
}

model Student {
  id             String       @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass @relation(fields: [tuitionClassId], references: [id])
  studentNumber  String
  fullName       String
  school         String?
  phone          String?
  parentPhone    String?
  username       String       @unique
  passwordHash   String
  createdAt      DateTime     @default(now())

  attendances Attendance[]
  marks       Mark[]

  @@unique([tuitionClassId, studentNumber])
}

model Attendance {
  id             String           @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass     @relation(fields: [tuitionClassId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  date           DateTime
  status         AttendanceStatus
  createdAt      DateTime         @default(now())

  @@unique([studentId, date])
}

model Exam {
  id             String     @id @default(uuid())
  tuitionClassId String
  tuitionClass   TuitionClass @relation(fields: [tuitionClassId], references: [id])
  title          String
  subject        String
  examDate       DateTime
  description    String?
  maxMarks       Int
  status         ExamStatus @default(DRAFT)
  createdAt      DateTime   @default(now())

  marks Mark[]
}

model Mark {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  marksObtained Int
  createdAt     DateTime @default(now())

  @@unique([examId, studentId])
}